rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return true; // Login removed by user request
    }

    function isVerified() {
      return true; // Login removed by user request
    }

    function isAdmin() {
      return true; // Login removed by user request
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Menu Item Validation
    function isValidMenuItem(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.category is string && (data.category in ['Makanan utama', 'Lauk', 'Minuman', 'Lainnya']) &&
             (data.get('imageUrl', '') is string) && (data.get('imageUrl', '').size() <= 1048576); // Allow up to 1MB for base64
    }

    match /menu/{itemId} {
      allow read: if true;
      allow create: if isValidMenuItem(incoming());
      allow update: if isValidMenuItem(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'price', 'category', 'imageUrl', 'available', 'updatedAt'])
      );
      allow delete: if true;
    }

    // Transaction Validation
    function isValidTransaction(data) {
      return data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.total is number && data.total >= 0 &&
             data.paymentMethod is string && (data.paymentMethod in ['Cash', 'QRIS']) &&
             (data.get('cashReceived', 0) is number) &&
             (data.get('change', 0) is number) &&
             data.createdAt == request.time;
    }

    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if isValidTransaction(incoming());
      allow update, delete: if false;
    }

    // Settings Validation
    function isValidSettings(data) {
      return (data.get('name', '') is string) &&
             (data.get('address', '') is string) && 
             (data.get('phone', '') is string) &&
             (data.get('qrisPayload', '') is string) && (data.get('qrisPayload', '').size() <= 2000);
    }

    match /settings/config {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidSettings(incoming());
    }
  }
}
